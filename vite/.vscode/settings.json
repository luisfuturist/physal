{
  "files.exclude": {
    "**/node_modules": true
  },
  "search.exclude": {
    "**/node_modules": true
  },

  "editor.tabSize": 2,

  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.patterns": {
    "package.json": "bun.lock, tsconfig*.json",
  },

  "files.associations": {
    "./docs/**/*.md": "markdown"
  }
}
